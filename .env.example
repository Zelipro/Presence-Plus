# Copiez ce fichier en .env et remplissez vos valeurs
# cp .env.example .env
#
# Optionnel: si ces variables sont définies, l'écran de configuration au
# démarrage sera sauté. Sinon, vous pourrez saisir l'URL et la clé
# directement dans l'application au premier lancement.

# URL de votre projet Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé API "anon" / "public" (Project Settings → API)
SUPABASE_KEY=eyJhbGciOi...
